# Copy this file to .env and fill in your own values. Never commit .env.
# ijob runs without the Langfuse stack; tracing is optional.

# Providers: the claude-sdk provider uses the local Claude Code login and needs no variable.
OPENROUTER_API_KEY=

# Tracing: OTLP over HTTP only (Langfuse does not accept gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
# Keys come from a Langfuse project's settings page. Form:
# Authorization=Basic <base64(public_key:secret_key)>,x-langfuse-ingestion-version=4
OTEL_EXPORTER_OTLP_HEADERS=

# Langfuse UI address. Ports bind to IPv4 127.0.0.1 only, so open http://127.0.0.1:3000;
# a browser can resolve "localhost" to IPv6 ::1 and hang.
NEXTAUTH_URL=http://127.0.0.1:3000

# Stack overrides for compose.yaml. Defaults are fine for a localhost-only stack.
# SALT=
# ENCRYPTION_KEY=  # generate with: openssl rand -hex 32
# NEXTAUTH_SECRET=
# POSTGRES_PASSWORD=  # also set DATABASE_URL to match
# CLICKHOUSE_PASSWORD=
# REDIS_AUTH=
# MINIO_ROOT_PASSWORD=  # also set the three LANGFUSE_S3_*_SECRET_ACCESS_KEY to match
